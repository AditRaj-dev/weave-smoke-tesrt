{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WEAVE Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "event_id",
    "seq",
    "kind",
    "project_id",
    "run_id",
    "task_id",
    "session_id",
    "ts",
    "payload"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
