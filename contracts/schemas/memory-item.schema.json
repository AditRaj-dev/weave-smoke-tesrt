{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WEAVE Memory Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "project_id",
    "task_id",
    "scope",
    "domain",
    "kind",
    "status",
    "content",
    "source",
    "author_session",
    "validator",
    "supersedes_id",
    "content_hash",
    "sensitivity",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "memory_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "global",
        "project",
        "domain",
        "task"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "decision",
        "observation",
        "lesson",
        "api",
        "handoff",
        "gotcha",
        "review"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "validated",
        "pinned",
        "rejected",
        "superseded"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "git",
            "artifact",
            "human_attestation",
            "legacy_memex"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "author_session": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "validator": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "sensitive"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
