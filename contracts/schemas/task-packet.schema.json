{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WEAVE TaskPacket v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "task_id",
    "session_id",
    "packet_version",
    "role",
    "provider",
    "phase_id",
    "cwd",
    "worktree",
    "feature_spec",
    "dependencies",
    "scopes",
    "memory_scopes",
    "contracts",
    "acceptance_criteria",
    "verification_commands",
    "tool_permissions",
    "report_destination",
    "created_at",
    "isolation_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
    },
    "packet_version": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "claude",
        "codex",
        "gemini",
        "generic"
      ]
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "feature_spec": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_paths",
        "write_paths",
        "resources"
      ],
      "properties": {
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "memory_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "version",
          "sha256"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,99}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tool_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_destination": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "isolation_mode": {
      "enum": [
        "cooperative",
        "enforced"
      ]
    }
  }
}
